
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /songs/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /audios/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /covers/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /photo-previews/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /photos-private/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /community/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 25 * 1024 * 1024;
    }

    match /profiles/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid;
    }
  }
}
